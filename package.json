{
  "name": "confire",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@confire/b1": "workspace:*",
    "@confire/config-engine": "workspace:*",
    "@confire/db": "workspace:*",
    "@confire/server": "workspace:*",
    "@orpc/client": "^1.14.6",
    "@orpc/server": "^1.14.6",
    "@types/bun": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "db:push": "bun --env-file=../../.env --cwd packages/db drizzle-kit push",
    "db:generate": "bun --cwd packages/db drizzle-kit generate",
    "db:studio": "bun --env-file=../../.env --cwd packages/db drizzle-kit studio",
    "auth:generate": "bun --cwd apps/server better-auth-generate",
    "dev": "bun run --parallel dev:server dev:app dev:agent dev:portal-server dev:portal",
    "dev:server": "bun run --hot --preload ./apps/server/src/instrument.ts apps/server/src/index.ts",
    "dev:app": "bun --cwd apps/app dev",
    "dev:portal-server": "bun run --hot --preload ./apps/server/src/instrument.ts apps/server/src/portal/index.ts",
    "dev:portal": "bun --cwd apps/portal dev",
    "build:app": "bun --cwd apps/app build",
    "build:portal": "bun --cwd apps/portal build",
    "seed:dev": "bun --env-file=.env scripts/seed-dev.ts",
    "seed:portal": "bun --env-file=.env scripts/seed-portal-company.ts",
    "e2e": "bun scripts/e2e.ts",
    "print:smoke": "bun scripts/print-smoke.ts",
    "test:engine": "bun test packages/config-engine",
    "test:server": "bun test apps/server",
    "test:app": "bun test apps/app",
    "test:ui": "bun test packages/ui",
    "kill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-dev.ps1",
    "seed:agent": "bun --env-file=.env scripts/seed-agent.ts",
    "dev:agent": "bun --cwd apps/agent dev",
    "dev:pair": "cloudflared tunnel --url http://localhost:3000"
  }
}
