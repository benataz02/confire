# One sign-in host and two sibling zones, one process each (spec 2026-10-17-single-sign-in-design.md).
# The subdomain IS the tenant: each server resolves it from the (preserved) Host header against its
# own base domain (tenant.ts) and validates it against membership — orpc/base.ts internally,
# portal/orpc/base.ts on the portal.
#   {$DOMAIN}                              sign-in (and the dispatcher at /login) -> server:3000
#   *.app.{$DOMAIN}                        staff app       -> server:3000
#   *.portal.{$DOMAIN}                     customer portal -> portal:3001
#   app.{$DOMAIN}, portal.{$DOMAIN}        nothing of their own -> the dispatcher
# The session cookie is on .{$DOMAIN}, so every host under it receives it: never point a name under
# {$DOMAIN} at a service this stack does not control.
# ponytail: the whole apex goes to the server until a marketing site exists; then split it by path
# (/login /signup /forgot-password /reset-password /onboarding /api/auth /rpc /assets and the mail
# logo to the server, the rest to marketing).
#
# CADDY_TLS picks where certificates come from (compose defaults it to `internal`):
#   internal    Caddy's local CA, for running the full stack on lvh.me.
#   cloudflare  One wildcard cert per zone through the ACME DNS challenge (a wildcard cannot use the
#               HTTP challenge), one provider token for both. Not a cert per tenant: every issued cert
#               lands in the public Certificate Transparency logs, so per-tenant certs would publish
#               the customer list.
(tls-internal) {
	tls internal
}

(tls-cloudflare) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

{$DOMAIN}, *.app.{$DOMAIN} {
	import tls-{$CADDY_TLS}
	reverse_proxy server:3000
}

*.portal.{$DOMAIN} {
	import tls-{$CADDY_TLS}
	reverse_proxy portal:3001
}

app.{$DOMAIN}, portal.{$DOMAIN} {
	import tls-{$CADDY_TLS}
	redir https://{$DOMAIN}/login
}
