<Project Sdk="Microsoft.NET.Sdk">
  <!-- confire-print.exe, Direct printing (print spec §5.3). .NET Framework 4.8 so it runs on Windows
       Server 2012 R2; built on Linux against Microsoft's reference assemblies. No Crystal DLL is
       referenced: Program.cs loads the box's runtime from the GAC. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>confire-print</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
