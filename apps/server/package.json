{
  "name": "@confire/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/orpc/router.ts",
    "./portal-router": "./src/portal/orpc/router.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run --preload ./src/instrument.ts src/index.ts",
    "better-auth-generate": "bunx auth@1.7.15 generate --config src/auth.ts --output ../../packages/db/src/schema/auth.ts -y",
    "start:portal": "bun run --preload ./src/instrument.ts src/portal/index.ts"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "@confire/b1": "workspace:*",
    "@confire/config-engine": "workspace:*",
    "@confire/db": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@orpc/client": "2.0.0-beta.45",
    "@orpc/openapi": "2.0.0-beta.45",
    "@orpc/server": "2.0.0-beta.45",
    "@sentry/bun": "^11.8.0",
    "@tanstack/ai": "^1.0.0",
    "@tanstack/ai-anthropic": "^1.0.0",
    "@tanstack/ai-mcp": "1.0.0",
    "@tanstack/ai-skills": "1.0.0",
    "better-auth": "1.7.15",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.0",
    "hono": "^4.12.26",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-email": "6.11.2",
    "resend": "^6.33.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
