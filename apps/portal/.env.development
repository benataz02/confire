# Dev only (vite dev mode). The portal's zone — a sibling of the internal app's (app.lvh.me), so
# neither session cookie reaches the other. Open http://portal.lvh.me:5180.
VITE_PORTAL_BASE_DOMAIN=portal.lvh.me
# Cloudflare Turnstile's documented always-pass TEST site key (pairs with the test secret in .env).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
