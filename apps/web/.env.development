# Dev only (vite dev mode). Tenant subdomains need a domain whose cookie is shared across
# subdomains — `localhost` is not (it behaves like a TLD), lvh.me is, and it resolves to 127.0.0.1
# at any depth. Sign in at http://lvh.me:5173 (VITE_AUTH_URL's default); its `.lvh.me` session
# cookie reaches both the staff app (acme.app.lvh.me:5173) and the portal (acme.portal.lvh.me:5180).
VITE_APP_BASE_DOMAIN=app.lvh.me
