# Dev only (vite dev mode). Tenant subdomains need a base domain whose parent-domain cookie
# is shared across subdomains — `localhost` is not (it behaves like a TLD), `app.lvh.me` is.
# lvh.me resolves to 127.0.0.1 at any depth. Open the app at http://app.lvh.me:5173.
# Not bare lvh.me: its cookie would also reach the portal's zone (portal.lvh.me).
VITE_APP_BASE_DOMAIN=app.lvh.me
